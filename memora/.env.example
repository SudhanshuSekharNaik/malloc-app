# Which provider to use: "groq" (free, no billing) or "anthropic" (paid)
LLM_PROVIDER=groq

# Groq - free, no credit card required. Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic - requires billing set up at console.anthropic.com. Only needed
# if you switch LLM_PROVIDER to "anthropic".
ANTHROPIC_API_KEY=your-anthropic-key-here
MEMORA_MODEL=claude-sonnet-5

# Database URL (SQLite for local dev; swap for Postgres in a later stage)
DATABASE_URL=sqlite:///./memora.db
